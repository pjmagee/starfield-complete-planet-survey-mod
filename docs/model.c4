// Complete Planet Survey — Architecture Model (shipped v1.3.0)
//
// Four console commands, each taking a category string (resources,traits,fauna,flora | all):
//   CompletePlanet         — the world you are standing on
//   CompleteBarrenPlanets  — every lifeless world (ref-free galaxy sweep)
//   CompleteLifePlanets    — every life-bearing world (ref-free, works from anywhere)
//   CompleteAllPlanets     — both sweeps, one combined result
//
// The model: survey DATA (attribute bits, scan flags, trait-known, the +0x08 marker
// catalogue) is written instantly and durably into the engine's knowledge DB — no
// spawning, no teleporting. Species lists and scan markers for never-visited worlds
// derive offline from Starfield.esm (PNDT/PPBD + CTDA evaluation). On-surface outlines
// and trait pillars are the game's own per-instance state and resolve on the next load.
// Completion also writes the character-sheet Statistics counters.

model {

  actor player 'Player' {
    description 'Starfield player who wants to complete planet surveys instantly'
  }

  game starfield 'Starfield' {
    description 'Bethesda Game Studios — Starfield (Creation Engine 2)'

    component scanPath 'Scan Path' {
      description 'Engine code path triggered when the player scans flora/fauna'

      function setScanned 'SetScanned (ID_83008)' {
        #ghidra
        description 'Scan entry point — flora (ID_83038) and fauna (ID_52160) branches both funnel into the progress updater'
      }

      function planetProgress 'PlanetProgress (ID_52157)' {
        #ghidra
        description 'Per-planet progress updater, reached for every successful species scan on any path. The hook call site.'
      }

      function surveyCheckNotify 'SurveyCheckNotify (ID_97853)' {
        #ghidra
        description '''
          Survey check-and-dispatch. Fires the progress event, and the complete
          event when the survey hits 100% — which drops the per-planet "Survey Data" slate.
        '''
      }
    }

    component completion 'Completion & Discovery Writers' {
      description 'The engine routines the mod drives directly, always with an EXPLICIT planet id'

      function setTraitKnown 'SetTraitKnown (ID_52155)' {
        #ghidra
        description 'Marks one trait keyword known for a planet id (the engine\'s own off-planet trait path, discriminator 938333)'
      }

      function scanFlags 'Scan-flag writers (ID_124898/124899)' {
        #ghidra
        description 'Per-species scan-flag increment + percent byte (+0x21) — the persistent "scanned" state the outline reads on load'
      }

      function discoverPlanet 'ScanCompletePlanet (ID_102650)' {
        #ghidra
        description 'Ref-free "discover a planet": creates the knowledge entry ASYNCHRONOUSLY, fires the slate event, recurses over moons'
      }
    }

    component knowledgeDb 'Knowledge Database' {
      description 'BSGalaxy::PlayerKnowledge — per-save singleton tracking what the player has discovered'

      function getManager 'GetKnowledgeManager (ID_126578)' {
        #ghidra
        description 'Returns the per-save knowledge-manager singleton; DB pointer at manager+0x8B0, lookup via ID_126806'
      }

      data surveyMap 'Per-planet survey map (db+0x268)' {
        #ghidra
        description '''
          BSTHashMap keyed (discriminator << 48) | (planet_id << 16).
          Value: per-planet component — attribute "known" bits, species/resource
          scan flags (+0x21), and the slot+0x08 attribute-marker catalogue.
        '''
      }
    }

    component statsSystem 'Character Statistics' {
      description 'The misc-stats system behind Data > Statistics (same store the ModPCMiscStat console command edits)'

      data statTable 'Misc-stat table (ID_889375/889377/894532)' {
        #ghidra
        description 'Interned-name → counter table; name globals for Flora/Fauna Fully Scanned + Unique Creatures Scanned (ID_923219/20/23)'
      }

      function statApi 'Game.QueryStat / IncrementStat' {
        #papyrus
        description 'The vanilla Papyrus misc-stat API — used to reconcile Planets Scanned ≥ Planets Fully Surveyed'
      }
    }

    component aggregator 'Survey Aggregator' {
      function surveyAggregator 'SurveyAggregator (ID_1016657)' {
        #ghidra
        description 'Per-planet enumerator: four span pairs (uint32[] traits/flora, TESForm*[] resources/other). Only returns forms the player already discovered.'
      }
    }

    component formRegistry 'Form Registry' {
      function allFormsMap 'AllFormsMap (ID_883341)' {
        #ghidra
        description 'Global BSTScatterTable<FormID,TESForm*>. The only place to enumerate every PNDT planet form (TESDataHandler arrays are empty for galaxy types).'
      }
    }

    component gameSettings 'Game Settings (GMST)' {
      function handScannerGmst 'iHandScanner{Animal,Plants}CountBase' {
        description 'Per-species required scan count. The mod sets these to 1 (built-in Instant Scan).'
      }
    }

    component events 'Game Events' {
      function progressEvent 'PlayerPlanetSurveyProgressEvent' {
        description 'Fired when survey percentage changes'
      }
      function completeEvent 'PlayerPlanetSurveyCompleteEvent' {
        description 'Fired when a survey NEWLY reaches 100% — drops the Survey Data slate and bumps Planets Fully Surveyed'
      }
    }

    data starfieldEsm 'Starfield.esm' {
      #esm
      description 'The base game master. PNDT records carry the authored per-biome flora/fauna (PPBD, zlib-compressed); FLST/OMOD/PERK CTDA chains encode the scan markers.'
    }
  }

  mod completePlanetSurvey 'Complete Planet Survey Mod' {
    description 'SFSE plugin + CK-authored ESM + Papyrus commands that complete planet surveys — one world or the whole galaxy'

    plugin sfsePlugin 'SFSE Plugin (DLL)' {
      #sfse
      description 'Native C++ plugin (CommonLibSF). Loaded by SFSE; registers natives + installs the scan hook and per-frame pollers on kPostDataLoad.'

      namespace hookNs 'Hook Namespace' {
        description 'The scan-path hook and the two main-thread per-frame pollers'

        function installHook 'Install()' {
          description 'write_call<5> on the ID_52157 → ID_97853 call site (found at runtime by scanning for the E8 rel32). Single intercept covers every scan path.'
        }

        function scanHookThunk 'ScanHook::thunk' {
          description 'Calls the original ID_97853, then DispatchStaticCall("CompleteSurveyIfEnabled") — defers all real work to Papyrus.'
        }

        function autoCompletePoller 'ScanSweepPoller (AddPermanentTask)' {
          description '''
            Main-thread per-frame task. When the pending flag is set AND menus are
            closed (+ grace frames): dispatches _AutoCompleteCurrentPlanet — the
            auto-complete-on-scan runs from a clean, non-scanner state.
          '''
        }

        function relinkPoller 'SessionReRegisterPoller (AddPermanentTask)' {
          description '''
            Formless scripts lose their VM types on quit-to-menu, which unbinds the
            natives. This poller re-binds them once gameplay resumes, so the cgf
            commands survive a Main-Menu → load. Every NEW native must be in its list.
          '''
        }
      }

      namespace papyrusNs 'Papyrus Natives' {
        description 'The 16 C++ functions bound to the Papyrus VM (run on a Papyrus worker thread)'

        function categoryCheck 'CategoryEnabled / CategoriesValid' {
          #papyrus
          description 'Parses the category string — an unknown token makes the whole command a clean no-op'
        }
        function markResources 'MarkResourcesForPlanet' {
          #papyrus
          description 'Single-planet resources completion: attribute bits + resource scan flags + the survey-complete check. Pure — never touches species.'
        }
        function markTrait 'MarkTraitKnownForPlanet' {
          #papyrus
          description 'Marks one trait keyword known (ID_52155). Data only — the in-world "0/N" pillars resolve on arrival.'
        }
        function greenSpecies 'TestDirectGreen' {
          #papyrus
          description 'The production species green, part 1: +0x21 scan flags + survey % for every authored species (kind: 0 both, 1 flora, 2 fauna). Name is historical — the RE probe that became the real method.'
        }
        function buildMarkers 'TestBuildArray' {
          #papyrus
          description 'The production species green, part 2: builds the slot+0x08 attribute-marker catalogue (genetics/reproduction/temperament/abilities) from the ESM derivation'
        }
        function discoverEntry 'DiscoverPlanetEntry' {
          #papyrus
          description 'Ref-free discover (ID_102650) so writes land on never-visited worlds. ASYNC — the reason the life sweep needs a finalize pass. Skipped for the current planet.'
        }
        function galaxySweep 'CompleteAllPlanetsSurveyData' {
          #papyrus
          description 'The barren galaxy sweep: enumerate every PNDT, skip life-bearing worlds, discover + write survey state (writeResources=false → enumerate-only for the traits path)'
        }
        function sweepAccess 'GetSweepPlanetCount / GetSweepPlanetFormIdAt' {
          #papyrus
          description 'Exposes the swept-planet list to the Papyrus finalize/trait loop'
        }
        function finalize 'FinalizeSweptPlanet' {
          #papyrus
          description 'Per-planet finalize after the async entry creates flush: re-apply state; fires the completion event only when the world NEWLY hits 100% (idempotent re-runs)'
        }
        function lifeEnum 'EnumerateLifePlanets / GetLifePlanetFormIdAt' {
          #papyrus
          description 'The life-sweep worklist: every planet with authored flora/fauna, from the ESM map'
        }
        function queueComplete 'QueueCompleteSurvey' {
          #papyrus
          description 'Sets the pending auto-complete atomic for the poller'
        }
        function cancelPending 'CancelPendingAutoComplete' {
          #papyrus
          description 'Manual command wins: clears any queued auto-complete so an explicit category is not overridden'
        }
      }

      namespace engineNs 'Engine Helpers + State' {
        description 'C++ helpers over the engine + the cross-thread state'

        function completeState 'CompletePlanetSurveyState' {
          description 'Attribute bits + every tracked resource scan flag (ID_124898/124899) + the survey-complete check (ID_97853)'
        }
        function esmSpecies 'MarkEsmSpeciesForPlanet' {
          description 'Writes each authored species\' scan flags + the slot+0x08 marker catalogue for one planet — the thing the runtime cannot give for an unvisited world'
        }
        function isFullyMarked 'IsPlanetFullyMarked' {
          description 'Idempotency gate: the survey-complete event fires only for worlds NEWLY at 100%, so re-runs never inflate Planets Fully Surveyed'
        }
        function incrementStat 'IncrementMiscStat' {
          description 'Writes the character-sheet counters (Flora/Fauna Fully Scanned, Unique Creatures Scanned) for species that newly reach a full scan'
        }
        function forEachForm 'ForEachFormOfType (PNDT)' {
          description 'Walks the global form registry (ID_883341) to enumerate every planet'
        }
        function instantScan 'ApplyInstantScanGameSettings' {
          description 'Sets the hand-scanner GMSTs to 1 on load (built-in Instant Scan)'
        }

        data pendingComplete 'g_pendingCompleteSurvey (atomic<bool>)' {
          description 'Set by QueueCompleteSurvey (worker thread), consumed by the poller (main thread)'
        }
        data sweptForms 'g_sweepPlanetForms (vector, mutex)' {
          description 'Planets the last barren sweep touched — consumed by the Papyrus finalize/trait pass'
        }
        data lifeCache 'g_lifePlanetCache (vector)' {
          description 'Life-bearing planet form ids from the ESM map — consumed via GetLifePlanetFormIdAt'
        }
      }

      namespace esmReaderNs 'ESM Reader' {
        #esm
        description 'Parses Starfield.esm directly at startup (no runtime dependency) — src/EsmReader.cpp, validated offline by test/build_validate.bat'

        function esmParse 'Esm::GetPlanetSpecies' {
          description 'Parses PNDT/PPBD (zlib-inflated), once + cached; returns planetId → [flora/fauna species formIDs]'
        }
        function speciesMarkers 'Esm::GetSpeciesMarkers (+ActorMarkers)' {
          description 'Evaluates the authored HandScanner CTDA conditions (FLST/OMOD/PERK chains) — derives every green marker per species per planet, 17/17 validated'
        }
      }
    }

    component esmPlugin 'ESM Plugin' {
      #esm
      description 'Creation Kit-authored CompletePlanetSurvey.esm — the Settings toggle + the immersive intro message'

      record gpog 'GPOG CPSGroup' {
        description 'Section header in Settings → Gameplay'
      }
      record gpof 'GPOF CPSScanAutoComplete (0x80C)' {
        description 'The "Auto-Complete Survey on Scan" toggle (checkbox)'
      }
      record recallMsg 'MESG CPSRecallMessage (0x807)' {
        description 'The modal immersive intro shown once per galaxy command (button-less message box)'
      }
    }

    component papyrusScripts 'Papyrus Scripts' {
      #papyrus
      description 'Console entry points + the glue that validates categories and orchestrates the natives'

      script questScript 'CompletePlanetSurveyQuest.psc' {
        description '''
          CompletePlanet / CompleteBarrenPlanets / CompleteLifePlanets /
          CompleteAllPlanets (each × categories), CompleteSurveyIfEnabled (the
          hook target: reads the toggle, queues), _AutoCompleteCurrentPlanet
          (the poller target), MarkTraits, _ReconcilePlanetsScanned.
        '''
      }
      script nativeScript 'CompletePlanetSurveyNative.psc' {
        description 'Declares the native function signatures bound by the DLL'
      }
    }
  }

  // ── Player ──
  player -> completePlanetSurvey 'Installs & runs the console commands'
  player -> starfield 'Plays'

  // ── Engine scan path (context) ──
  starfield.scanPath.setScanned -[calls]-> starfield.scanPath.planetProgress 'Flora + fauna branches'
  starfield.scanPath.planetProgress -[fires]-> starfield.scanPath.surveyCheckNotify 'Completion check'
  starfield.scanPath.surveyCheckNotify -[fires]-> starfield.events.progressEvent 'On % change'
  starfield.scanPath.surveyCheckNotify -[fires]-> starfield.events.completeEvent 'At a NEW 100%'

  // ── Auto-complete on scan: hook → toggle gate → deferred dispatch ──
  completePlanetSurvey.sfsePlugin.hookNs.installHook -[hooks]-> starfield.scanPath.planetProgress 'Patches the ID_52157 → ID_97853 call site'
  completePlanetSurvey.sfsePlugin.hookNs.scanHookThunk -[hooks]-> starfield.scanPath.surveyCheckNotify 'Intercepts, calls the original first'
  completePlanetSurvey.sfsePlugin.hookNs.scanHookThunk -[calls]-> completePlanetSurvey.papyrusScripts.questScript 'DispatchStaticCall(CompleteSurveyIfEnabled)'
  completePlanetSurvey.papyrusScripts.questScript -[reads]-> completePlanetSurvey.esmPlugin.gpof 'Reads the toggle (Game.GetFormFromFile 0x80C)'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.queueComplete 'If toggle on + planet < 100%'
  completePlanetSurvey.sfsePlugin.papyrusNs.queueComplete -[writes]-> completePlanetSurvey.sfsePlugin.engineNs.pendingComplete
  completePlanetSurvey.sfsePlugin.papyrusNs.cancelPending -[writes]-> completePlanetSurvey.sfsePlugin.engineNs.pendingComplete 'Manual command clears the queue'
  completePlanetSurvey.sfsePlugin.hookNs.autoCompletePoller -[reads]-> completePlanetSurvey.sfsePlugin.engineNs.pendingComplete 'When menus closed + grace frames'
  completePlanetSurvey.sfsePlugin.hookNs.autoCompletePoller -[calls]-> completePlanetSurvey.papyrusScripts.questScript 'Dispatches _AutoCompleteCurrentPlanet → CompletePlanet("all")'
  completePlanetSurvey.sfsePlugin.hookNs.relinkPoller -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs 'Re-binds all natives after Main-Menu → load'

  // ── Command bodies (category-routed) ──
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.categoryCheck 'Validate + route the category string'
  completePlanetSurvey.papyrusScripts.questScript -[reads]-> completePlanetSurvey.esmPlugin.recallMsg 'Modal immersive intro (galaxy commands)'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.markResources '"resources"'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.markTrait '"traits" — per trait keyword (MarkTraits)'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.greenSpecies '"fauna"/"flora" — _GreenPlanet part 1'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.buildMarkers '"fauna"/"flora" — _GreenPlanet part 2'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.galaxySweep 'Barren sweep'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.sweepAccess 'Finalize/trait loop worklist'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.finalize 'Per swept planet'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.lifeEnum 'Life-sweep worklist'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> completePlanetSurvey.sfsePlugin.papyrusNs.discoverEntry 'Never-visited life worlds first'
  completePlanetSurvey.papyrusScripts.questScript -[calls]-> starfield.statsSystem.statApi 'Reconcile Planets Scanned ≥ Fully Surveyed'

  // ── Natives → engine helpers → engine ──
  completePlanetSurvey.sfsePlugin.papyrusNs.markResources -[calls]-> completePlanetSurvey.sfsePlugin.engineNs.completeState
  completePlanetSurvey.sfsePlugin.papyrusNs.discoverEntry -[calls]-> starfield.completion.discoverPlanet 'Async knowledge-entry create'
  completePlanetSurvey.sfsePlugin.papyrusNs.markTrait -[calls]-> starfield.completion.setTraitKnown
  completePlanetSurvey.sfsePlugin.papyrusNs.greenSpecies -[calls]-> starfield.completion.scanFlags 'Per authored species'
  completePlanetSurvey.sfsePlugin.papyrusNs.greenSpecies -[reads]-> completePlanetSurvey.sfsePlugin.esmReaderNs.esmParse 'Authored species list'
  completePlanetSurvey.sfsePlugin.papyrusNs.buildMarkers -[calls]-> completePlanetSurvey.sfsePlugin.engineNs.esmSpecies
  completePlanetSurvey.sfsePlugin.papyrusNs.galaxySweep -[calls]-> completePlanetSurvey.sfsePlugin.engineNs.forEachForm 'Enumerate planets'
  completePlanetSurvey.sfsePlugin.papyrusNs.galaxySweep -[calls]-> starfield.completion.discoverPlanet 'Discover + slate per barren world'
  completePlanetSurvey.sfsePlugin.papyrusNs.galaxySweep -[calls]-> completePlanetSurvey.sfsePlugin.engineNs.completeState 'When writeResources'
  completePlanetSurvey.sfsePlugin.papyrusNs.galaxySweep -[writes]-> completePlanetSurvey.sfsePlugin.engineNs.sweptForms
  completePlanetSurvey.sfsePlugin.papyrusNs.sweepAccess -[reads]-> completePlanetSurvey.sfsePlugin.engineNs.sweptForms
  completePlanetSurvey.sfsePlugin.papyrusNs.finalize -[calls]-> completePlanetSurvey.sfsePlugin.engineNs.completeState 'Re-apply after async creates flush'
  completePlanetSurvey.sfsePlugin.papyrusNs.finalize -[calls]-> completePlanetSurvey.sfsePlugin.engineNs.isFullyMarked 'Fire complete only when NEWLY 100%'
  completePlanetSurvey.sfsePlugin.papyrusNs.lifeEnum -[reads]-> completePlanetSurvey.sfsePlugin.engineNs.lifeCache
  completePlanetSurvey.sfsePlugin.engineNs.lifeCache -[reads]-> completePlanetSurvey.sfsePlugin.esmReaderNs.esmParse 'Worlds with authored species'
  completePlanetSurvey.sfsePlugin.engineNs.forEachForm -[reads]-> starfield.formRegistry.allFormsMap

  // ── The green write ──
  completePlanetSurvey.sfsePlugin.engineNs.esmSpecies -[reads]-> completePlanetSurvey.sfsePlugin.esmReaderNs.speciesMarkers 'Derived marker set'
  completePlanetSurvey.sfsePlugin.engineNs.esmSpecies -[writes]-> starfield.knowledgeDb.surveyMap 'slot+0x08 marker catalogue'
  completePlanetSurvey.sfsePlugin.engineNs.esmSpecies -[calls]-> completePlanetSurvey.sfsePlugin.engineNs.incrementStat 'Newly-full species'
  completePlanetSurvey.sfsePlugin.engineNs.incrementStat -[writes]-> starfield.statsSystem.statTable 'Flora/Fauna/Unique counters'
  starfield.statsSystem.statApi -[writes]-> starfield.statsSystem.statTable 'Same store as ModPCMiscStat'

  // ── Knowledge DB + shared writes ──
  completePlanetSurvey.sfsePlugin.engineNs.completeState -[calls]-> starfield.aggregator.surveyAggregator 'Mark every tracked form'
  completePlanetSurvey.sfsePlugin.engineNs.completeState -[calls]-> starfield.completion.scanFlags 'Resource scan flags'
  completePlanetSurvey.sfsePlugin.engineNs.completeState -[writes]-> starfield.knowledgeDb.surveyMap 'Attribute bits'
  completePlanetSurvey.sfsePlugin.engineNs.completeState -[fires]-> starfield.scanPath.surveyCheckNotify 'Survey-complete check'
  starfield.completion.setTraitKnown -[writes]-> starfield.knowledgeDb.surveyMap 'Trait-known bits'
  starfield.completion.scanFlags -[writes]-> starfield.knowledgeDb.surveyMap 'Scan flags + percent'
  starfield.knowledgeDb.getManager -[reads]-> starfield.knowledgeDb.surveyMap 'manager+0x8B0'

  // ── ESM parsing ──
  completePlanetSurvey.sfsePlugin.esmReaderNs.esmParse -[reads]-> starfield.starfieldEsm 'PNDT/PPBD, zlib'
  completePlanetSurvey.sfsePlugin.esmReaderNs.speciesMarkers -[reads]-> starfield.starfieldEsm 'FLST/OMOD/PERK CTDA chains'

  // ── Instant Scan + toggle wiring ──
  completePlanetSurvey.sfsePlugin.engineNs.instantScan -[writes]-> starfield.gameSettings.handScannerGmst 'On load'
  completePlanetSurvey.esmPlugin.gpof -> completePlanetSurvey.esmPlugin.gpog 'Backs the Settings entry'
  completePlanetSurvey.papyrusScripts.nativeScript -> completePlanetSurvey.sfsePlugin.papyrusNs 'Declares native bindings'
}
