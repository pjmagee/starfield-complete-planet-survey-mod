// Complete Planet Survey — Architecture Model (high level)
//
// The whole mod in one sentence: the player runs a console command, the mod looks up
// what a planet is supposed to have (from the game's data file) and writes "you've
// surveyed all of it" straight into the game's in-memory survey knowledge — no flying
// there, no scanning. It also ticks the character-sheet counters to match.
//
// This model stays blackboxed on purpose: components, and who reads/writes what.
// The engine-level detail (function ids, memory offsets, bit flags) lives in re/ and
// the local RE notes, not in these diagrams.

model {

  actor player 'Player' {
    description 'Wants planet surveys finished instantly, from the console'
  }

  // ── The game ──
  system starfield 'Starfield' {
    description 'Bethesda Game Studios — the running game'

    store gameData 'Game Data (Starfield.esm)' {
      description 'The base-game file that says which plants, animals, resources and traits every planet is supposed to have'
    }

    store surveyKnowledge 'Survey Knowledge' {
      description 'In-memory record of what the player has discovered on each planet — the thing the scanner and the map read from. Saved with the game.'
    }

    store statistics 'Character Statistics' {
      description 'The Data > Statistics counters: planets surveyed, flora/fauna scanned, unique creatures'
    }

    component scanning 'Scanning' {
      description 'What normally happens when the player points the hand scanner at a plant or animal'
    }
  }

  // ── The mod ──
  mod cps 'Complete Planet Survey Mod' {
    description 'Console commands that finish planet surveys — one world, or the whole galaxy, instantly'

    component commands 'Console Commands' {
      description 'What the player types (Papyrus). Complete this planet, all barren worlds, all life worlds, or everything — each for resources, traits, flora or fauna.'
    }

    component plugin 'Survey Writer (SFSE Plugin)' {
      description 'The native brain of the mod. Given a planet, it writes the finished survey into the game\'s knowledge in-memory, and updates the counters.'
    }

    component esmReader 'Data Reader' {
      description 'Reads the game data file directly to learn what each planet holds — even for worlds the player has never visited.'
    }

    component settings 'Settings Toggle' {
      description 'An in-game options checkbox: "Auto-Complete Survey on Scan".'
    }
  }

  // ── How it fits together ──
  player -[uses]-> commands 'Runs the commands'
  player -[uses]-> starfield 'Plays'

  commands -[uses]-> plugin 'Asks it to finish a survey'
  commands -[reads]-> settings 'Checks whether auto-complete is on'

  plugin -[uses]-> esmReader 'What does this planet have?'
  esmReader -[reads]-> gameData 'Plants, animals, resources, traits'

  plugin -[writes]-> surveyKnowledge 'Marks resources, species and traits as fully surveyed'
  plugin -[writes]-> statistics 'Bumps the scanned / surveyed counters to match'

  // ── Auto-complete on scan ──
  scanning -[uses]-> commands 'A scan can trigger auto-complete (if the toggle is on)'
  settings -[uses]-> scanning 'Gates it'

  // The scanner and map simply read the knowledge the mod wrote
  scanning -[reads]-> surveyKnowledge 'Shows it as surveyed'
}
