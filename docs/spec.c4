// Complete Planet Survey — LikeC4 specification
// Element kinds, relationship kinds and styling. Kept deliberately small:
// the diagrams are high-level (components + reads/writes), not a function map.

specification {

  element actor {
    style {
      shape person
      color green
    }
  }

  element system {
    style {
      shape rectangle
      color slate
    }
  }

  element mod {
    style {
      shape rectangle
      color indigo
    }
  }

  element component {
    style {
      shape rectangle
      color sky
    }
  }

  element store {
    style {
      shape storage
      color muted
    }
  }

  // Relationship kinds — the only verbs the diagrams use
  relationship reads
  relationship writes
  relationship uses
}
