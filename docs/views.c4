// Complete Planet Survey — Views (high level, blackboxed)

views {

  // ── Overview: player, mod, game ──
  view index {
    title 'Complete Planet Survey — Overview'
    description 'The whole picture: the player runs a command, the mod reads game data and writes finished surveys into the game.'

    include player
    include cps, cps.*
    include starfield, starfield.*

    autoLayout LeftRight
  }

  // ── How completion works: read the data, write the survey ──
  view howItWorks {
    title 'How It Works — Read the Data, Write the Survey'
    description '''
      The player runs a command. The mod's writer asks the data reader what the planet
      holds (plants, animals, resources, traits), reads it from the game data file, and
      writes it all back as "surveyed" into the game's in-memory survey knowledge. The
      character-sheet counters are ticked to match. No travel, no scanning.
    '''

    include player,
            cps.commands,
            cps.plugin,
            cps.esmReader,
            starfield.gameData,
            starfield.surveyKnowledge,
            starfield.statistics

    autoLayout LeftRight
  }

  // ── Auto-complete on scan ──
  view onScan {
    title 'Auto-Complete on Scan'
    description '''
      With the Settings toggle on, scanning a plant or animal triggers the same
      completion for the world you are standing on — the scan just kicks off the writer.
    '''

    include player,
            starfield.scanning,
            cps.settings,
            cps.commands,
            cps.plugin,
            starfield.surveyKnowledge

    autoLayout LeftRight
  }
}
